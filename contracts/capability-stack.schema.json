{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sugar144/general-governance/contracts/capability-stack.schema.json",
  "title": "GOV-GEN adopter capability stack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stack_id", "status", "components", "compatibility_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stack_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["PREPARED", "ACTIVE"]},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "role", "repository", "commit_sha", "governance_authority"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
          "role": {
            "enum": [
              "GOVERNANCE_FRAMEWORK",
              "GOVERNANCE_CAPABILITY",
              "EVIDENCE_OBSERVABILITY_CAPABILITY"
            ]
          },
          "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "version": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "binding_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "governance_authority": {"enum": ["OWN_DOMAIN_ONLY", "NONE"]}
        }
      }
    },
    "compatibility_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "result"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "PASS"}
        }
      }
    }
  }
}
