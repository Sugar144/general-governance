{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sugar144/general-governance/contracts/release-manifest.schema.json",
  "title": "General Governance release manifest",
  "oneOf": [
    {"$ref": "#/$defs/legacy13"},
    {"$ref": "#/$defs/scoped14"}
  ],
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_contract", "consumer_lock_schema", "consumer_configuration_schema"],
      "properties": {
        "framework_contract": {"const": "2.0.0"},
        "consumer_lock_schema": {"const": "2.0.0"},
        "consumer_configuration_schema": {"const": "1.0.0"}
      }
    },
    "capabilityComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "stack_schema", "optional"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "stack_schema": {"const": "1.0.0"},
        "optional": {"const": true}
      }
    },
    "workPacketDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "adoption_contract_version", "binding_schema_version", "manifest_schema_version", "optional"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "adoption_contract_version": {"const": "1.0.0"},
        "binding_schema_version": {"const": "1.0.0"},
        "manifest_schema_version": {"const": "1.0.0"},
        "optional": {"const": true}
      }
    },
    "legacy13": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_schema_version", "repository", "framework_version", "release_status", "compatibility", "capability_composition", "work_packet_design", "content_sha256", "content_identity_method", "extraction_provenance", "evolution_provenance", "required_framework_surfaces"],
      "properties": {
        "manifest_schema_version": {"const": "1.3.0"},
        "repository": {"const": "Sugar144/general-governance"},
        "framework_version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "release_status": {"type": "string", "minLength": 1},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "capability_composition": {"$ref": "#/$defs/capabilityComposition"},
        "work_packet_design": {"$ref": "#/$defs/workPacketDesign"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_identity_method": {"type": "string", "minLength": 1},
        "extraction_provenance": {"type": "string", "minLength": 1},
        "evolution_provenance": {"type": "string", "minLength": 1},
        "required_framework_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scopedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "default_classification", "manifest_self_excluded", "reserved_operational_prefixes", "operational_exact_paths"],
      "properties": {
        "method": {"const": "SCOPED_TRACKED_FILES_V1"},
        "default_classification": {"const": "RELEASE_INCLUDED"},
        "manifest_self_excluded": {"const": true},
        "reserved_operational_prefixes": {"type": "array", "prefixItems": [{"const": "governance/"}], "items": false, "minItems": 1, "maxItems": 1},
        "operational_exact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": [".gitignore", "AGENTS.md", "PROJECT_STATE.yaml", "ROADMAP.md", "project-state-integrity.json", "scripts/project_state_integrity.py", ".github/pull_request_template.md", ".github/workflows/project-state-integrity.yml"]}
        }
      }
    },
    "scoped14": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_schema_version", "repository", "framework_version", "release_status", "compatibility", "capability_composition", "work_packet_design", "content_sha256", "content_identity", "extraction_provenance", "evolution_provenance", "required_framework_surfaces"],
      "properties": {
        "manifest_schema_version": {"const": "1.4.0"},
        "repository": {"const": "Sugar144/general-governance"},
        "framework_version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "release_status": {"type": "string", "minLength": 1},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "capability_composition": {"$ref": "#/$defs/capabilityComposition"},
        "work_packet_design": {"$ref": "#/$defs/workPacketDesign"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_identity": {"$ref": "#/$defs/scopedIdentity"},
        "extraction_provenance": {"type": "string", "minLength": 1},
        "evolution_provenance": {"type": "string", "minLength": 1},
        "required_framework_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
