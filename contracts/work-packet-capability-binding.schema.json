{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sugar144/general-governance/contracts/work-packet-capability-binding.schema.json",
  "title": "GOV-GEN WPDC adopter binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "capability_id",
    "adoption_contract_version",
    "capability_contract_version",
    "adopter",
    "source_bindings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "binding_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "capability_id": {"const": "work-packet-design-dependency-closure"},
    "adoption_contract_version": {"const": "1.0.0"},
    "capability_contract_version": {"const": "1.0.0"},
    "adopter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adopter_id"],
      "properties": {
        "adopter_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}
      }
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "classes", "locator"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
          "classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["AUTHORITY", "STATE", "REQUIREMENTS", "ARCHITECTURE", "DECISION", "PLANNING"]}
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": {"const": "REPOSITORY_PATH"},
                  "value": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": {"enum": ["EXTERNAL_REFERENCE", "STATE_OBSERVER"]},
                  "value": {"type": "string", "minLength": 1, "maxLength": 2048}
                }
              }
            ]
          },
          "currentness_rule_ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"}
        }
      }
    },
    "packet_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      }
    },
    "currentness_rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "mode"],
            "properties": {
              "rule_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
              "mode": {"const": "IMMUTABLE"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "mode", "reference"],
            "properties": {
              "rule_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
              "mode": {"const": "REFERENCE_BOUND"},
              "reference": {"type": "string", "minLength": 1, "maxLength": 2048}
            }
          }
        ]
      }
    }
  }
}
